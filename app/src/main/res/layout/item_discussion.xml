<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#CC121212">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnMenuOptions"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#889099" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btnMenuOptions"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDiscussionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título do Tópico"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#E8EDF2"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtDiscussionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conteúdo da mensagem..."
                android:textSize="15sp"
                android:textColor="#DDDDDD"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/txtAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="username"
                    android:textSize="12sp"
                    android:textColor="#74C6E0"/>

                <TextView
                    android:id="@+id/txtDiscussionMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · há 2 horas"
                    android:textSize="12sp"
                    android:textColor="#889099"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtReplyCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 12 respostas"
                    android:textSize="13sp"
                    android:textColor="#74C6E0"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver mais ▶"
                    android:textSize="13sp"
                    android:textColor="#889099"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
