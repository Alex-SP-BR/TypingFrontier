<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔍 Procurar Usuário"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtSearchUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ex: Cion"
            android:inputType="text"/>

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressSearch"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginVertical="8dp"/>

    <LinearLayout
        android:id="@+id/layoutUserInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:background="#EEEEEE">

        <TextView
            android:id="@+id/txtUserDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="username"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/txtUserRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cargo: USUÁRIO"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/txtUserStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: ATIVO"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/txtBanReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Motivo: ..."
            android:textSize="12sp"
            android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBanAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="16dp">

        <EditText
            android:id="@+id/edtBanReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Motivo do banimento"
            android:inputType="text"/>

        <Spinner
            android:id="@+id/spinnerDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnExecuteBan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BANIR"
            android:layout_marginTop="8dp"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnExecuteUnban"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DESBANIR"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:backgroundTint="#388E3C"
        android:textColor="#FFFFFF"/>

</LinearLayout>
