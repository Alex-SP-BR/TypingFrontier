<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:background="@drawable/bg_admin_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Procurar Usuário"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/edtSearchUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Ex: Cion"
                android:backgroundTint="#74C6E0"
                android:textColor="#FFFFFF"
                android:textColorHint="#8EA4C8"
                android:inputType="text"
                android:textCursorDrawable="@null"/>

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@null"
                android:background="@drawable/bg_game_button_primary"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="Buscar"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressSearch"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginVertical="12dp"/>

        <LinearLayout
            android:id="@+id/layoutUserInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="#33000000">

            <TextView
                android:id="@+id/txtUserDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="username"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#74C6E0"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"/>

            <TextView
                android:id="@+id/txtUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargo: USUÁRIO"
                android:textColor="#D0D6DD"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/txtUserStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: ATIVO"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/txtBanReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motivo: ..."
                android:textColor="#889099"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBanAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <EditText
                android:id="@+id/edtBanReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Motivo do banimento"
                android:backgroundTint="#74C6E0"
                android:textColor="#FFFFFF"
                android:textColorHint="#8EA4C8"
                android:inputType="text"
                android:textCursorDrawable="@null"/>

            <Spinner
                android:id="@+id/spinnerDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#74C6E0"/>

            <Button
                android:id="@+id/btnExecuteBan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BANIR USUÁRIO"
                android:layout_marginTop="16dp"
                android:backgroundTint="@null"
                android:background="@drawable/bg_game_button_primary"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnExecuteUnban"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESBANIR USUÁRIO"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:backgroundTint="@null"
            android:background="@drawable/bg_game_button_secondary"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
