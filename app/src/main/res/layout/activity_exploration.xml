<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:fitsSystemWindows="true">

        <!-- TELA DE SELEÇÃO DE ZONA -->
        <LinearLayout
            android:id="@+id/layoutSelecaoZona"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- HUD FIXO NA SELEÇÃO -->
            <include
                android:id="@+id/includeHudSelection"
                layout="@layout/layout_vital_bars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Onde você quer se aventurar?"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvZonas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnVoltarMapa"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Voltar ao Mapa"
                android:textAllCaps="false"
                android:textColor="#D0D6DD" />
        </LinearLayout>

        <!-- TELA DE AVENTURA EM CURSO -->
        <LinearLayout
            android:id="@+id/layoutAventura"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- HUD ROLÁVEL NA AVENTURA -->
                    <include
                        android:id="@+id/includeHudAdventure"
                        layout="@layout/layout_vital_bars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="#CC121212"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/txtZonaNome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Explorando: Zona"
                                android:textColor="#74C6E0"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtEtapaAventura"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Etapa 1"
                                android:textColor="#D0D6DD"
                                android:textSize="14sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="12dp"
                                android:background="#33FFFFFF" />

                            <TextView
                                android:id="@+id/txtDescricaoEvento"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="80dp"
                                android:text="Você entra silenciosamente no local..."
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:lineSpacingExtra="4dp" />

                            <TextView
                                android:id="@+id/txtResultadoEvento"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textColor="#81C784"
                                android:textStyle="bold"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:id="@+id/layoutAcoesAventura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnIrMaisFundo"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_game_button_primary"
                            android:backgroundTint="@null"
                            android:text="IR MAIS FUNDO ➡"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnSairComLoot"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="12dp"
                            android:text="FUGIR COM O QUE TENHO 🏃"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            app:strokeColor="#FFFFFF" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnFinalizar"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_game_button_primary"
                        android:backgroundTint="@null"
                        android:text="CONTINUAR"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>
            </ScrollView>

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
