<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Espaçador de segurança superior para o Skip button e HUD -->
    <View
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top" />

    <!-- FASE 1: LOGO TEXTO -->
    <TextView
        android:id="@+id/txtLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="TypingFrontier"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:alpha="0" />

    <!-- FASE 2: CINEMATIC -->
    <FrameLayout
        android:id="@+id/containerCinematic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">

        <ImageView
            android:id="@+id/imgCity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/imgProfessions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0" />

        <View
            android:id="@+id/viewFog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#22000000" />

        <LinearLayout
            android:id="@+id/layoutNarrativa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="80dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/text_bg_intro"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/txtNarrativa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="serif"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSkip"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:text="Pular"
            android:textColor="#FFFFFF"
            android:alpha="0.8" />

        <!-- FASE 3: LOGO FINAL (app_icon_base) -->
        <ImageView
            android:id="@+id/imgFinalLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/app_icon_base"
            android:scaleType="centerCrop"
            android:alpha="0"
            android:visibility="gone" />

        <View
            android:id="@+id/viewBlackOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:alpha="0"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
