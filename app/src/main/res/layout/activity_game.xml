<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HUD CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DDDDDD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgPersonagem"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/homem" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNomePlayer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jogador"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/txtTempo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dia 1 - 08:00"
                            android:textSize="14sp"
                            android:textColor="#666666" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtDinheiro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💰 100"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginVertical="8dp" />

                <!-- BARRAS DE STATUS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/lblNivel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⭐ Nível 1"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/btnHelpNivel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="\?"
                        android:textColor="#999999"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressXP"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:progress="0"
                    android:progressTint="#2196F3"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/lblVida"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="❤️ Vida"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/btnHelpVida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="\?"
                        android:textColor="#999999"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/progressVida"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="100"
                    android:progressTint="#E53935"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/lblEnergia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ Energia"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/btnHelpEnergia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="\?"
                        android:textColor="#999999"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/progressEnergia"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="100"
                    android:progressTint="#FBC02D"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/lblMente"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🧠 Cansaço Mental"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/btnHelpMente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="\?"
                        android:textColor="#999999"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/progressMente"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="0"
                    android:progressTint="#7B1FA2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DESCRIPTION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <TextView
                android:id="@+id/txtDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="O que vamos fazer hoje?"
                android:textSize="15sp"
                android:gravity="center"
                android:textColor="#444444" />
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTÕES DE AÇÃO -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:rowOrderPreserved="false">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp">

                <Button
                    android:id="@+id/btnExplore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌍 Explorar"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/btnHelpExplore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:padding="8dp"
                    android:text="\?"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:alpha="0.7" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp">

                <Button
                    android:id="@+id/btnTrabalhar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💼 Trabalhar"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/btnHelpWork"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:padding="8dp"
                    android:text="\?"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:alpha="0.7" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp">

                <Button
                    android:id="@+id/btnTreinoFisico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏋️ Físico"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/btnHelpTrainPhysical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:padding="8dp"
                    android:text="\?"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:alpha="0.7" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp">

                <Button
                    android:id="@+id/btnTreinoMental"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧠 Mental"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/btnHelpTrainMental"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:padding="8dp"
                    android:text="\?"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:alpha="0.7" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp">

                <Button
                    android:id="@+id/btnComer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🥪 Comer"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/btnHelpEat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:padding="8dp"
                    android:text="\?"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:alpha="0.7" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp">

                <Button
                    android:id="@+id/btnDescansar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧘 Pausa"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/btnHelpRest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:padding="8dp"
                    android:text="\?"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:alpha="0.7" />
            </FrameLayout>

            <Button
                android:id="@+id/btnLoja"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🛒 Loja"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="📊 Status"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnSettingsInGame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="⚙️ Configurações"
                android:textAllCaps="false" />

        </GridLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnDormir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="😴 Dormir (Passar o Dia)"
                android:backgroundTint="#3F51B5"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/btnHelpSleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:padding="8dp"
                android:text="\?"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:alpha="0.7" />
        </FrameLayout>

        <Button
            android:id="@+id/btnSair"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sair do Jogo"
            android:textColor="#999999" />

    </LinearLayout>
</ScrollView>
