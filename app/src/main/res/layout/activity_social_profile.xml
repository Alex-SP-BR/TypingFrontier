<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_perfil" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Cabeçalho do Perfil -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgProfileAvatar"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:src="@drawable/homem"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="?attr/shapeAppearanceMediumComponent"
                            android:layout_marginBottom="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"/>

                        <TextView
                            android:id="@+id/txtProfileUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="username"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#74C6E0"/>

                        <TextView
                            android:id="@+id/txtProfileCharacterName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nome do Personagem"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Estatísticas Sociais -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estatísticas Sociais"
                    android:textStyle="bold"
                    android:textColor="#74C6E0"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Linha 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:id="@+id/txtProfileLevel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Nível: 1"
                                android:textColor="#FFFFFF"/>
                            <TextView
                                android:id="@+id/txtProfileInt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Inteligência: 0"
                                android:textColor="#FFFFFF"/>
                        </LinearLayout>

                        <!-- Linha 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:id="@+id/txtProfileStr"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Força: 0"
                                android:textColor="#FFFFFF"/>
                            <TextView
                                android:id="@+id/txtProfileSpd"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Velocidade: 0"
                                android:textColor="#FFFFFF"/>
                        </LinearLayout>

                        <!-- Linha 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:id="@+id/txtProfileRes"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Resistência: 0"
                                android:textColor="#FFFFFF"/>
                            <TextView
                                android:id="@+id/txtProfileCha"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Carisma: 0"
                                android:textColor="#FFFFFF"/>
                        </LinearLayout>

                        <!-- Linha 4 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/txtProfileExp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Aventuras: 0"
                                android:textColor="#FFFFFF"/>
                            <TextView
                                android:id="@+id/txtProfileStreak"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Seq. Mental: 0"
                                android:textColor="#FFFFFF"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Insígnias/Conquistas -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Insígnias Desbloqueadas"
                    android:textStyle="bold"
                    android:textColor="#74C6E0"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerProfileBadges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <Button
                    android:id="@+id/btnRegistrarIdentidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registrar Identidade Social"
                    android:layout_marginTop="32dp"
                    android:visibility="gone"
                    android:backgroundTint="#E53935"/>

            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:layout_margin="16dp"
            android:textColor="#FFFFFF"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

    </LinearLayout>
</FrameLayout>
