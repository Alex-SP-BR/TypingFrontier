<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Cabeçalho do Perfil -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfileAvatar"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:src="@drawable/homem"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="?attr/shapeAppearanceMediumComponent"
                        android:layout_marginBottom="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                    <TextView
                        android:id="@+id/txtProfileUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="username"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1976D2"/>

                    <TextView
                        android:id="@+id/txtProfileCharacterName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome do Personagem"
                        android:textSize="16sp"
                        android:textColor="#666666"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Estatísticas Sociais -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estatísticas Sociais"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtProfileLevel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Nível: 1"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txtProfileInt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Inteligência: 0"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txtProfileStr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Força: 0"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txtProfileSpd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Velocidade: 0"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txtProfileRes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Resistência: 0"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txtProfileCha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Carisma: 0"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txtProfileExp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Aventuras: 0"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txtProfileStreak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="Seq. Mental: 0"
                        android:layout_marginBottom="4dp"/>
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Insígnias/Conquistas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Insígnias Desbloqueadas"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProfileBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <Button
                android:id="@+id/btnRegistrarIdentidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registrar Identidade Social"
                android:layout_marginTop="32dp"
                android:visibility="gone"
                app:backgroundTint="#E53935"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Voltar"
        android:layout_margin="16dp"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>

</LinearLayout>
