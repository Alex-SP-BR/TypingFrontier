<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="1dp">

    <ImageButton
        android:id="@+id/btnReplyMenu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_more"
        app:tint="#666666" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/btnReplyMenu"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtReplyAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="username"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtReplyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conteúdo da resposta"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtReplyDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="há 10 minutos"
            android:textSize="10sp"
            android:textColor="#999999"
            android:gravity="end"/>
    </LinearLayout>

</RelativeLayout>
